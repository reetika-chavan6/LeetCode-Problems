//using map (dictionary)
class Solution(object):
    def isAnagram(self, s, t):
        d={}
        r={}
        for i in s:
            d[i]=d.get(i,0)+1
        for j in t:
            r[j]=r.get(j,0)+1
        if d==r:
            return True
        return False


