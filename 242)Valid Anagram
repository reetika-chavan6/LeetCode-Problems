class Solution(object):
    def isAnagram(self, s, t):
        return sorted(s)==sorted(t)

//method 3:
class Solution(object):
    def isAnagram(self, s, t):
        if len(s)!=len(t):
            return False
        c=[0]*26
        for i in s:
            c[ord(i)-ord('a')]+=1
        for j in t:
            if c[ord(j)-ord('a')]==0:
                return False
            c[ord(j)-ord('a')]-=1
        return True
