#method 1
class Solution(object):
    def judgeSquareSum(self, c):
        s=floor(sqrt(c))
        l=0
        r=s
        while l<=r:
            if l*l + r*r ==c:
                return True
            elif l*l +r*r < c:
                l+=1
            else:
                r-=1
        return False

#method 2
class Solution(object):
    def judgeSquareSum(self, c):
        l=0
        r=int(c**0.5)
        while l<=r:
            if l*l + r*r ==c:
                return True
            elif l*l +r*r < c:
                l+=1
            else:
                r-=1
        return False
