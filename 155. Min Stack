class MinStack(object):

    def __init__(self):
        self.stack =[]
        self.minStack=[]
        

    def push(self, value):
        self.stack.append(value)
        if not self.minStack or value<=self.minStack[-1]:
            self.minStack.append(value)
            
        """
        :type value: int
        :rtype: None
        """
        

    def pop(self):
        value=self.stack .pop()
        if value==self.minStack[-1]:
            self.minStack.pop(-1)
        """
        :rtype: None
        """
        

    def top(self):
        
        return self.stack[-1]
        """
        :rtype: int
        """
        

    def getMin(self):
        return self.minStack[-1]
        
            
        """
        :rtype: int
        """
        
