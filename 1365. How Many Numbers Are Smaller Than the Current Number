#BRUTE FORCE APPROACH
class Solution(object):
    def smallerNumbersThanCurrent(self, nums):
        s=[]
        for i in range(len(nums)):
            count=0
            for j in range(len(nums)):
                if nums[i]>nums[j]:
                    count+=1
            s.append(count)
        return s

#OPTIMAL SOLUTION
class Solution(object):
    def smallerNumbersThanCurrent(self, nums):
        sortedNums=sorted(nums)
        ans=[]
        for i in nums:
            ans.append(sortedNums.index(i))
        return ans
