# using formula
class Solution(object):
    def missingNumber(self, nums):
        n=len(nums)
        sum=(n*(n+1))/2
        actual=0
        for i in nums:
            actual+=i
        return sum-actual


# using bit manipulations
class Solution(object):
    def missingNumber(self, nums):
        n=len(nums)
        xor=0
        for i in range(n+1):
            xor ^=i
        for i in nums:
            xor ^=i
        return xor
