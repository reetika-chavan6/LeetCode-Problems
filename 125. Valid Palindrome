class Solution(object):
    def isPalindrome(self, s):
        # new=""
        # for i in s:
        #     if i.isalnum():
        #         new+=i
        # new=new.lower()
        new = ''.join(ch.lower() for ch in s if ch.isalnum())
        left=0
        right=len(new)-1
        while(left<right):
            if new[left] == new[right]:
                left+=1
                right-=1
            else:
                return False
        return True
                
