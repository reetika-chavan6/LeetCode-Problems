class Solution(object):
    def removeKdigits(self, num, k):
        stack=[]
        for i in num:
            while stack and stack[-1]>i and k > 0:
                stack.pop()
                k-=1
            stack.append(i)
        while k>0:
            stack.pop()
            k-=1
        res="".join(stack).lstrip("0")
        if res:
            return res
        return '0'

      
        
