class Solution(object):
    def diameterOfBinaryTree(self, root):
        diameter=[0]
        def check(root):
            if not root :
                return 0
            left=check(root.left)
            right=check(root.right)
            diameter[0]=max(diameter[0],left+right)
            return 1+max(left,right)
        check(root)
        return diameter[0]
