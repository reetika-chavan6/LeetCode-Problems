class Solution(object):
    def hasPathSum(self, root, targetSum):
        def check(root,total):
            if not root:
                return False
            total+=root.val
            if not root.left and not root.right:
                return total==targetSum
            return check(root.left,total) or check(root.right,total)
        return check(root,0)
