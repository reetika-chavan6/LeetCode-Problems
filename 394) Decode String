class Solution(object):
    def decodeString(self, s):
        curr=""
        stack=[]
        num=0
        for ch in s:
            if ch.isdigit():
                num=num*10+int(ch)
            elif ch=="[":
                stack.append((num,curr))
                num=0
                curr=''
            elif ch=="]":
                int1,prev=stack.pop()
                curr=prev+int1*curr
            else:
                curr+=ch
        return curr
