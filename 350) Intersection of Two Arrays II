class Solution(object):
    def intersect(self, nums1, nums2):
        freq={}
        a=[]
        for i in nums1:
            freq[i]=freq.get(i,0)+1
        for j in nums2:
            if j in freq and freq[j]>0:
                a.append(j)
                freq[j]-=1
        return a
    
        
