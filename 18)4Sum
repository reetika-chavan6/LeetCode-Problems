class Solution(object):
    def fourSum(self, nums, target):
        num=sorted(nums)
        a=[]
        seen=set()
       
        for i in range(len(num)-3):
            for k in range(i+1,len(num)-2):
                l=k+1
                r=len(num)-1
                while l < r:
                    total=num[i]+num[k]+num[l]+num[r]
                    s=(num[i],num[k],num[l],num[r])
                    if total==target:
                        if s not in seen:
                            seen.add(s)
                            a.append(list(s))
                        l+=1
                        r-=1
                    elif total<target:
                        l+=1
                      
                    else:
                        r-=1
        return a


#optimal solution
class Solution(object):
    def fourSum(self, nums, target):
        nums.sort()
        ans = []

        for i in range(len(nums) - 3):

            # skip duplicate i
            if i > 0 and nums[i] == nums[i - 1]:
                continue

            for k in range(i + 1, len(nums) - 2):

                # skip duplicate k
                if k > i + 1 and nums[k] == nums[k - 1]:
                    continue

                l = k + 1
                r = len(nums) - 1

                while l < r:

                    total = nums[i] + nums[k] + nums[l] + nums[r]

                    if total == target:
                        ans.append([nums[i], nums[k], nums[l], nums[r]])

                        # skip duplicate l
                        while l < r and nums[l] == nums[l + 1]:
                            l += 1

                        # skip duplicate r
                        while l < r and nums[r] == nums[r - 1]:
                            r -= 1

                        l += 1
                        r -= 1

                    elif total < target:
                        l += 1

                    else:
                        r -= 1

        return ans
