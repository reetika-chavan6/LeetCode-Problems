class Solution(object):
    def maxDepth(self, root):
        if not root:
            return 0
        q=deque([root])
        depth=0
        while q:
            for i in range(len(q)):
                node=q.popleft()
                if node.left:
                    q.append(node.left)
                if node.right:
                    q.append(node.right)
            depth+=1
        return depth
#OR
class Solution(object):
    def maxDepth(self, root):
        if not root:
            return 0
        left=self.maxDepth(root.left)
        right=self.maxDepth(root.right)
        return 1+max(left,right)
