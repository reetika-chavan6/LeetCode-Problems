class Solution(object):
    def canConstruct(self, ransomNote, magazine):
        freq={}
        for i in ransomNote:
            freq[i]=freq.get(i,0)+1
        freq1={}
        for j in magazine:
            freq1[j]=freq1.get(j,0)+1
        for ch in ransomNote :
            if ch not in freq1 or freq[ch] > freq1[ch]:
                return False
        return True
