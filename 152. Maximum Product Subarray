class Solution(object):
    def maxProduct(self, nums):
        currMax=nums[0]
        currMin=nums[0]
        result=nums[0]
        for i in range(1,len(nums)):
            newMax=max(nums[i],currMax*nums[i],currMin*nums[i])
            newMin=min(nums[i],currMax*nums[i],currMin*nums[i])
            currMax=newMax
            currMin=newMin
            result=max(result,newMax)
        return result
