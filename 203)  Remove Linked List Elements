# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def removeElements(self, head, val):
        dummy=ListNode(0)
        dummy.next=head
        slow=dummy
        while slow.next:
            if slow.next.val==val:
                slow.next=slow.next.next
            else:
                slow=slow.next
        return dummy.next
       
        
