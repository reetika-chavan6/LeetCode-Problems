# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def mergeKLists(self, lists):
        if not lists:
            return None
        result=lists[0]
        for i in range(1,len(lists)):
            result= self.mergeTwoSortedList(result,lists[i])
        return result
        
    def mergeTwoSortedList(self,list1,list2):
        dummy=ListNode(0)
        curr=dummy
        while list1 and list2:
            if list1.val <= list2.val:
                curr.next=list1
                list1=list1.next
                curr=curr.next
            else:
                curr.next=list2
                list2=list2.next
                curr=curr.next
        if list1:
            curr.next=list1
        else:
            curr.next=list2
        return dummy.next
    
        
