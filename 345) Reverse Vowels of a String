class Solution(object):
    def reverseVowels(self, k):
        v="aeiouAEIOU"
        s=list(k)
        l=0
        r=len(s)-1
        while l<r:
            if s[l] in v and s[r] in v:
                s[l],s[r]=s[r],s[l]
                r-=1
                l+=1
            elif s[l] in v:
                r-=1
            elif s[r] in v:
                l+=1
            
            else:
                l+=1
        return "".join(s)
    
        
