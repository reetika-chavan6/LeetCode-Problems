# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def deleteDuplicates(self, head):
        if head is None:
            return head
        slow=head
        fast=head.next
        while fast:
            if slow.val == fast.val:
                slow.next=fast.next
                fast=fast.next
            else:
                slow=fast
                fast=fast.next
        return head

        
