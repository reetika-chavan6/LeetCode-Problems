class Solution(object):
    def maxSubarraySumCircular(self, nums):
        total=sum(nums)
        currMax=nums[0]
        ansMax=nums[0]
        circrMin=nums[0]
        circularAns=nums[0]
        for i in range(1,len(nums)):
            currMax=max(nums[i],nums[i]+currMax)
            ansMax=max(ansMax,currMax)

            circrMin=min(nums[i],nums[i]+circrMin)
            circularAns=min(circrMin,circularAns)
        if ansMax<0:
            return ansMax
        return max(ansMax,total-circularAns)
