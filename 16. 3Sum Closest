class Solution(object):
    def threeSumClosest(self, nums, target):
        num=sorted(nums)
        closest=num[0]+num[1]+num[2]
        for i in range(len(num)):
            l=i+1
            r=len(num)-1
            while l<r:
                total=num[i]+num[l]+num[r]
                if abs(total-target) <abs(closest-target):
                    closest=total
                if total==target:
                    return total
                elif total<target:
                    l+=1
                else:
                    r-=1
        return   closest
