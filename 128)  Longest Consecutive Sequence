class Solution(object):
    def longestConsecutive(self, nums):
        #Hash set
        longest=0
        s=set(nums)
        for i in s:
            if i-1 not in s:
                length=1
                while i+length in s:
                    length +=1
                longest=max(length,longest)
        return longest
      
class Solution(object):
    def longestConsecutive(self, nums):
        # hash map
        freq = {}
        for i in nums:
            freq[i] = 1
        longest = 0
        for i in freq:
            if i - 1 not in freq:
                length = 1
                while i + length in freq:
                    length += 1
                longest = max(longest,length)
        return longest
