#Brute Force Algorithm
class Solution(object):
    def containsNearbyDuplicate(self, nums, k):
        for i in range(len(nums)):
            for j in range(i+1,len(nums)):
                if nums[i]==nums[j] and j-i<=k:
                    return True
        return False

#SLIDING WINDOW (1)
class Solution(object):
    def containsNearbyDuplicate(self, nums, k):
        for i in range(len(nums)):
            s = nums[max(0, i-k):i]
            if nums[i] in s:
                return True
        return False

#SLIDING WINFOW (2)
class Solution(object):
    def containsNearbyDuplicate(self, nums, k):
        window=set()
        for i in range(len(nums)):
            if nums[i] in window :
                return True
            window.add(nums[i])
            if len(window) > k:
                window.remove(nums[i-k])
        return False
