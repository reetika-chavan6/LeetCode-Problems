class Solution(object):
    def myPow(self, x, n):
        if n < 0:
            return 1.0 / self.power(x, -n)

        return self.power(x, n)

    def power(self, x, n):
        if n == 0:
            return 1.0

        if n % 2 == 0:
            return self.power(x * x, n // 2)
        else:
            return x * self.power(x * x, n // 2)


    
        
