class Solution(object):
    def shipWithinDays(self, weights, days):
        l=max(weights)
        r=sum(weights)
        while l<=r: 
            mid=(l+r) // 2
            day=1
            current=0
            for weight in weights:
                if weight+current > mid:
                    day+=1
                    current=0
                current+=weight
            if day<=days:
                r=mid-1
            else:
                l=mid+1
        return l
            
