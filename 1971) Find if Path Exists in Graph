class Solution(object):
    def validPath(self, n, edges, source, destination):
        adj=[[] for i in range(n)]
        for u,v in edges:
            adj[u].append(v)
            adj[v].append(u)
        visited=set()
        def dfs(node):
            if node==destination:
                return True
            visited.add(node)
            for nei in adj[node]:
                if nei  not in visited:
                    if dfs(nei):
                        return True
            return False
        return dfs(source)

        """
        :type n: int
        :type edges: List[List[int]]
        :type source: int
        :type destination: int
        :rtype: bool
        """
        
