class Solution(object):
    def binaryTreePaths(self, root):
        result=[]
        ans=[]
        def check(root):
            if not root:
                return
            ans.append(root.val)
            if not root.left and not root.right:
                result.append("->".join(map(str, ans)))
            else:
                check(root.left)
                check(root.right)
            ans.pop()
        check(root)
        return result


      
        
