class Solution(object):
    def generateParenthesis(self, n):
        result = []

        def solve(curr, open_count, close_count):

            if len(curr) == 2 * n:
                result.append(curr)
                return

            if open_count < n:
                solve(curr + "(", open_count + 1, close_count)

            if close_count < open_count:
                solve(curr + ")", open_count, close_count + 1)

        solve("", 0, 0)

       
        
