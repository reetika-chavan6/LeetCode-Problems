class Solution(object):
    def frequencySort(self, s):
        freq={}
        for ch in s:
            freq[ch]=freq.get(ch,0)+1
        arr=list(freq.items())
        for i in range(len(arr)):
            for j in range(i+1,len(arr)):
                if arr[i][1]<arr[j][1]:
                    arr[j],arr[i]=arr[i],arr[j]
        ans=""
        for ch,count in arr:
            ans+=(ch*count)
        return ans
