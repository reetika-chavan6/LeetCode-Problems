class Solution(object):
    def letterCombinations(self, digits):
        result=[]
        phone={
            "2":"abc",
            "3":"def",
            "4":"ghi",
            "5":"jkl",
            "6":"mno",
            "7":"pqrs",
            "8":"tuv",
            "9":"wxyz"
            
        }
        def solve(index,curr,):
            if index==len(digits):
                result.append("".join(curr))
                return 
            if index<0:
                return 
            letters=phone[digits[index]]
            for letter in letters:
                curr.append(letter)
                solve(index+1,curr)
                curr.pop()
        solve(0,[])
        return result
            
            
    
        
