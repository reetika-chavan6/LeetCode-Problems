class Solution(object):
    def finalPrices(self, prices):
        s=[]
        for i in range(len(prices)):
            for j in range(i+1,len(prices)):
                if prices[i]>=prices[j]:
                    s.append(prices[i]-prices[j])   
                    break   
            else:
                s.append(prices[i])
        return s

