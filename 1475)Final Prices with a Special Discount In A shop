class Solution(object):
    def finalPrices(self, prices):
        res=prices
        s=[]
        for i in range(len(res)):
            while s and prices[s[-1]]>=prices[i]:
                j=s.pop()
                res[j]-=prices[i]
            s.append(i)
        return res
