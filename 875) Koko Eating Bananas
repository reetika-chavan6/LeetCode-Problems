class Solution(object):
    def minEatingSpeed(self, piles, h):
        l=1
        r=max(piles)
        while l<=r:
            mid=(l+r)//2
            hours=0
            for i in range(len(piles)):
                # hours+=ceil(piles[i]/mid)
                hours += (piles[i] + mid - 1) // mid
            if hours<=h: #to get the minimum value
                r=mid-1
            else:
                l=mid+1
        return l
