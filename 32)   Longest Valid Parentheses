class Solution(object):
    def longestValidParentheses(self, s):
        stack=[-1]
        maxCount=0
        for i in range(len(s)):
            if s[i]=='(':
                stack.append(i)
            else:
                stack.pop()
                if stack :
                    maxCount=max(maxCount,i-stack[-1])
                else:
                    stack.append(i)
        return maxCount
