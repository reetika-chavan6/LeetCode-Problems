class Solution(object):
    def reverseBetween(self, head, left, right):
        dummy=ListNode(0)
        dummy.next=head
        prev=dummy
        for i in range(left-1):
            prev=prev.next
        curr=prev.next
        for i in range(right-left):
            newNode=curr.next
            curr.next=newNode.next
            newNode.next=prev.next
            prev.next=newNode
        return dummy.next

        #Keep prev before left, then repeatedly move curr.next to the front of the sublist until positions left to right are reversed.
