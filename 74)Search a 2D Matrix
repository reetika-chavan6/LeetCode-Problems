class Solution(object):
    def searchMatrix(self, matrix, target):
        rows=len(matrix)
        col=len(matrix[0])
        l=0
        r=rows*col-1
        while l<=r:
            mid=(l+r)//2
            row=mid//col  #to know which row the index is present
            columns=mid%col   # to know which column the index is present
            if matrix[row][columns]==target:
                return True
            elif matrix[row][columns]<target:
                l=mid+1
            else:
                r=mid-1
        return False
