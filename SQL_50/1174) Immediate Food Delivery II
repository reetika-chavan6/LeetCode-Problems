SELECT round(
    sum(
    case when d.order_date= d.customer_pref_delivery_date
    then 1  else 0 
    end )*100.0/ count(*) ,2) 
    as immediate_percentage 
FROM Delivery as d
where (d.customer_id,d.order_date) in (select customer_id,min(order_date)
    from Delivery 
    group by customer_id )
