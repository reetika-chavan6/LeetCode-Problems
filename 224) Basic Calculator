class Solution(object):
    def calculate(self, s):
        stack=[]
        result=0
        sign=1
        num=0
        for ch in s:
            if ch.isdigit():
                num=num*10+int(ch)
            elif ch =='+':
                result+=num*sign
                sign=1
                num=0
            elif ch=='-':
                result+=num*sign 
                sign=-1
                num=0
            elif ch == '(':
                stack.append(result)
                stack.append(sign)
                result=0
                sign=1
                num=0
            elif ch ==')':
                result+=num*sign
                num=0
                sign=stack.pop()
                prev_result=stack.pop()
                result=prev_result+sign*result
                sign=1
        result+=num*sign 
        return result 
            
        
    
